# Node API: expose through HTTPS reverse proxy; default listener is loopback.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/leaderboard.sqlite
PUBLIC_ORIGIN=https://game.example.com
# Set to 1 ONLY behind a proxy that overwrites X-Real-IP, with no direct API access.
TRUST_PROXY=0

# Optional administration at /admin/; inject a private random password (16+ chars).
# Never use a VITE_ prefix. Empty means administration is disabled.
ADMIN_PASSWORD=
