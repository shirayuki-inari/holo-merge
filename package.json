{
  "name": "holo-merge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.workers.json",
    "test:browser": "node scripts/browser-test.mjs",
    "test:audio-browser": "node scripts/audio-browser-test.mjs",
    "test:character-audio": "node scripts/character-audio-browser-test.mjs",
    "package": "npm run build && python scripts/package-game.py && npm run package:backends",
    "test:release": "node scripts/release-browser-test.mjs",
    "server:dev": "tsx server/node.ts",
    "server:build": "esbuild server/node.ts --bundle --platform=node --format=esm --outfile=server-dist/node.mjs",
    "server:start": "node server-dist/node.mjs",
    "workers:dev": "wrangler dev --port 8787",
    "workers:deploy": "wrangler deploy",
    "workers:check": "wrangler deploy --dry-run --outdir .qa/worker-build",
    "workers:build": "esbuild workers/index.ts --bundle --format=esm --platform=browser --external:cloudflare:workers --outfile=server-dist/worker.mjs",
    "test:leaderboard-browser": "node scripts/leaderboard-browser-test.mjs",
    "test:backend": "tsx scripts/backend-smoke.ts",
    "package:backends": "npm run server:build && npm run workers:build && python scripts/package-backends.py",
    "test:settings-browser": "node scripts/settings-browser-test.mjs",
    "test:admin": "tsx scripts/admin-smoke.ts",
    "test:admin-browser": "node scripts/admin-browser-test.mjs",
    "test:admin-release": "node scripts/admin-release-test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "matter-js": "^0.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.152.0"
  }
}
