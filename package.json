{
  "name": "holo-merge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc -b",
    "test:browser": "node scripts/browser-test.mjs",
    "test:audio-browser": "node scripts/audio-browser-test.mjs",
    "test:character-audio": "node scripts/character-audio-browser-test.mjs",
    "package": "npm run build && python scripts/package-game.py",
    "test:release": "node scripts/release-browser-test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "matter-js": "^0.20.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "tsx": "^4.20.0",
    "playwright-core": "^1.56.0"
  }
}
